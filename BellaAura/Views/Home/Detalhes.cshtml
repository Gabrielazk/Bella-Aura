<!-- 🧠 JAVASCRIPT DINÂMICO FUNCIONAL -->
<script>
    function trocarFotoPadrao(src) {
        document.getElementById('fotoPrincipalPadrao').src = src;
        document.querySelectorAll('.miniatura-padrao').forEach(img => img.classList.remove('active'));
        if (event && event.target) event.target.classList.add('active');
    }

    document.addEventListener("DOMContentLoaded", function() {
        const estrelas = document.querySelectorAll('.estrela-click');
        const inputNota = document.getElementById('notaSelecionada');

        estrelas.forEach(estrela => {
            estrela.addEventListener('click', function() {
                const valor = parseInt(this.getAttribute('data-valor'));
                inputNota.value = valor;

                estrelas.forEach(e => {
                    const eValor = parseInt(e.getAttribute('data-valor'));
                    if (eValor <= valor) {
                        e.classList.remove('far');
                        e.classList.add('fas');
                        e.style.color = '#ffd700';
                    } else {
                        e.classList.remove('fas');
                        e.classList.add('far');
                        e.style.color = '#444444';
                    }
                });
            });
        });
    });

    function enviarOpiniao(event) {
        event.preventDefault();

        const nota = parseInt(document.getElementById('notaSelecionada').value);
        const nome = document.getElementById('nomeCliente').value;
        const texto = document.getElementById('textoOpiniao').value;

        if (nota === 0) {
            alert("Por favor Gabi, selecione as estrelinhas para dar sua nota! 😉");
            return;
        }

        let estrelasHtml = "";
        for (let i = 0; i < 5; i++) {
            if (i < nota) {
                estrelasHtml += '<i class="fas fa-star" style="color: #ffd700;"></i>';
            } else {
                estrelasHtml += '<i class="far fa-star" style="color: #444444;"></i>';
            }
        }

        const lista = document.getElementById('listaComentarios');
        const novoComentario = document.createElement('div');
        novoComentario.className = "pb-2 border-bottom border-secondary border-opacity-10";
        novoComentario.innerHTML = `
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="fw-bold text-white" style="font-size: 13px;">${nome}</span>
                    <span class="badge bg-success-subtle text-success ms-2" style="font-size: 9px;">Compra Verificada ✔</span>
                </div>
                <small class="text-muted" style="font-size: 10px;">Agora mesmo</small>
            </div>
            <div class="my-1" style="font-size: 10px;">${estrelasHtml}</div>
            <p style="font-size: 12px; color: #ccc;" class="m-0">${texto}</p>
        `;

        lista.insertBefore(novoComentario, lista.firstChild);

        document.getElementById('formAvaliacao').reset();
        document.getElementById('notaSelecionada').value = "0";
        document.querySelectorAll('.estrela-click').forEach(e => {
            e.classList.remove('fas');
            e.classList.add('far');
            e.style.color = '#444444';
        });

        alert("Opinião publicada com sucesso na lista abaixo! 🖤✨");
    }

    function verTodasOpinioes() {
        alert("Carregando histórico de opiniões da Bella Aura... 🧾✨");
    }

    function adicionarDiretoNoCarrinho(id, nome, precoStr, foto) {
        let precoNumerico = parseFloat(precoStr.toString().replace('R$', '').replace('.', '').replace(',', '.').trim()) || 340.00;

        let carrinho = JSON.parse(localStorage.getItem('carrinhoBellaAura')) || [];

        let itemExistente = carrinho.find(item => item.id === id);

        if (itemExistente) {
            itemExistente.qtd += 1;
        } else {
            carrinho.push({
                id: id,
                nome: nome || 'Kit Luxury',
                preco: precoNumerico,
                qtd: 1,
                foto: foto || 'https://images.unsplash.com/photo-1592945403244-b3fbafd7f539?auto=format&fit=crop&w=300&q=80'
            });
        }

        localStorage.setItem('carrinhoBellaAura', JSON.stringify(carrinho));

        if (typeof atualizarBadgeGlobal === 'function') {
            atualizarBadgeGlobal();
        } else {
            let elementoBadge = document.getElementById('badgeCarrinho');
            if (elementoBadge) {
                let total = 0;
                carrinho.forEach(i => total += i.qtd);
                elementoBadge.innerText = total;
            }
        }

        alert(`✨ "${nome}" foi adicionado ao seu carrinho!`);
    }

    let tamanhoAtual = '50 ml';
    let precoBase = 340.00;

    function selecionarTamanho(botao, novoPreco, tamanho) {
        // Remove a classe ativa de todos e coloca no clicado
        document.querySelectorAll('.btn-tamanho, .btn-tamanho-gold').forEach(b => b.classList.remove('active'));
        botao.classList.add('active');

        // Atualiza variáveis e preço na tela
        tamanhoAtual = tamanho;
        precoBase = novoPreco;

        // Atualiza o elemento do preço na tela
        let elemPreco = document.getElementById('precoDinamico');
        if (elemPreco) {
            elemPreco.innerText = `R$ ${novoPreco.toFixed(2).replace('.', ',')}`;
        }
    }
</script>