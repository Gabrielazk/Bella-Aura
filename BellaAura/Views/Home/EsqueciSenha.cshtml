<section class="pagina_login">
    <div class="container-fluid h-100">
        <div class="row h-100 justify-content-center align-items-center bg-preto-login">
            <div class="caixa_login text-center">
                <h2 class="titulo_boas_vindas">Recuperar Senha ✨</h2>
                <p class="subtitulo_login">Digite seu e-mail cadastrado. Enviaremos as instruções para você redefinir sua senha.</p>

                @if (TempData["MensagemSucesso"] != null)
                {
                    <div class="alert text-center small mb-4" style="background-color: rgba(205, 164, 94, 0.1); border: 1px solid #cda45e; color: #cda45e; border-radius: 6px;">
                        @TempData["MensagemSucesso"]
                    </div>
                }

                @if (ViewBag.Erro != null)
                {
                    <div class="alert text-center small mb-4" style="background-color: rgba(220, 53, 69, 0.1); border: 1px solid #dc3545; color: #dc3545; border-radius: 6px;">
                        @ViewBag.Erro
                    </div>
                }

                @if (TempData["EmailSimulado"] != null)
                {
                    <div class="text-start p-3 mb-4" style="background-color: #111; border: 1px dashed #cda45e; border-radius: 6px; font-family: monospace; font-size: 12px; color: #eee;">
                        <span style="color: #cda45e; font-weight: bold;">📬 [Simulador de E-mail Bella Aura]:</span>
                        <pre class="mt-2 mb-0" style="color: #ccc; white-space: pre-wrap; font-family: monospace;">@TempData["EmailSimulado"]</pre>
                    </div>
                }

                <form asp-action="EsqueciSenha" asp-controller="Home" method="post">
                    <div class="mb-4 text-start">
                        <label class="label_custom">E-mail Cadastrado</label>
                        <div class="input_container">
                            <i class="fas fa-envelope"></i>
                            <input type="email" name="email" class="input_login" placeholder="seu-email@exemplo.com" required>
                        </div>
                    </div>

                    <button type="submit" class="btn_entrar_conta mb-3">Enviar Link de Recuperação</button>

                    <p class="texto_cadastrar">
                        Lembrou a senha? <a href="/Home/Login" class="link_dourado">Voltar para o Login</a>
                    </p>
                </form>
            </div>
        </div>
    </div>
</section>