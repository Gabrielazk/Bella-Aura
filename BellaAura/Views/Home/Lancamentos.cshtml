        }
</style>

<!-- 🧠 SCRIPT INTEGRADO COM O NOSSO CARRINHO E FAVORITOS -->
<script>
    function adicionarAoCarrinhoLancamento(id, nome, preco, foto) {
        let carrinho = JSON.parse(localStorage.getItem('carrinhoBellaAura')) || [];
        let itemExistente = carrinho.find(item => item.id === id);

        if (itemExistente) {
            itemExistente.qtd += 1;
        } else {
            carrinho.push({
                id: id,
                nome: nome,
                preco: parseFloat(preco),
                qtd: 1,
                foto: foto
            });
        }

        localStorage.setItem('carrinhoBellaAura', JSON.stringify(carrinho));

        // Atualiza o badge do menu
        let badge = document.getElementById('badgeCarrinho');
        if (badge) {
            let total = 0;
            carrinho.forEach(i => total += i.qtd);
            badge.innerText = total;
        }

        alert(`✨ Lançamento "${nome}" foi adicionado ao seu carrinho!`);
    }
</script>