<section class="pagina_login">
    <div class="container-fluid h-100">
        <div class="row h-100">

            <div class="col-md-5 d-none d-md-block coluna_imagem_login">
                <div class="conteudo_sobreposto">
                    <img src="/images/logo_preta.png" alt="Bella Aura" class="logo_login_lateral" />
                    <h1 class="titulo_lateral">Sua experiência começa <span class="dourado_destaque">aqui ✨</span></h1>
                    <p class="texto_lateral">Entre para descobrir kits exclusivos criados para momentos únicos.</p>
                </div>
            </div>

            <div class="col-md-7 d-flex align-items-center justify-content-center bg-preto-login position-relative">
                <div class="caixa_login">
                    <h2 class="titulo_boas_vindas">Bem-vinda de volta! ✨</h2>
                    <p class="subtitulo_login">Faça login para acessar sua conta e continuar comprando.</p>

                    @if (TempData["MensagemSucesso"] != null)
                    {
                        <div class="alert text-center small mb-4" style="background-color: rgba(205, 164, 94, 0.1); border: 1px solid #cda45e; color: #cda45e; border-radius: 6px;">
                            @TempData["MensagemSucesso"]
                        </div>
                    }

                    <!-- 1. Adicionamos as rotas e o método POST no form -->
                    <form asp-action="Login" asp-controller="Home" method="post">

                        <!-- Se o login falhar, mostramos esse aviso vermelho de erro -->
                        @if (ViewBag.Erro != null)
                        {
                            <div class="alert text-center small mb-4" style="background-color: rgba(220, 53, 69, 0.1); border: 1px solid #dc3545; color: #dc3545; border-radius: 6px;">
                                @ViewBag.Erro
                            </div>
                        }

                        <div class="mb-3">
                            <label class="label_custom">E-mail</label>
                            <div class="input_container">
                                <i class="fas fa-envelope"></i>
                                <!-- 2. Adicionamos o name="email" aqui -->
                                <input type="email" name="email" class="input_login" placeholder="Digite seu e-mail" required>
                            </div>
                        </div>

                        <div class="mb-3">
                            <div class="d-flex justify-content-between">
                                <label class="label_custom">Senha</label>
                                <a href="/Home/EsqueciSenha" class="link_esqueci">Esqueci minha senha</a>
                            </div>
                            <div class="input_container">
                                <i class="fas fa-lock"></i>
                                <!-- 3. Adicionamos o name="senha" aqui -->
                                <input type="password" name="senha" class="input_login" placeholder="Digite sua senha" required>
                                <i class="fas fa-eye icone_ver_senha"></i>
                            </div>
                        </div>

                        <button type="submit" class="btn_entrar_conta">Entrar na minha conta</button>

                        <div class="divisor_login">
                            <span>ou continue com</span>
                        </div>

                        <div class="row g-2">
                            <div class="col-6">
                                <button type="button" class="btn_social"><i class="fab fa-google me-2"></i> Google</button>
                            </div>
                            <div class="col-6">
                                <button type="button" class="btn_social"><i class="fab fa-facebook-f me-2"></i> Facebook</button>
                            </div>
                        </div>

                        <p class="texto_cadastrar">
                            Ainda não tem uma conta? <a href="/Home/Cadastrar" class="link_dourado">Criar conta</a>
                        </p>
                    </form>
                </div>
            </div>

            <footer class="rodape_bella_aura">
                <div class="faixa_beneficios_premium">
                    <div class="container">
                        <div class="row text-center py-3">
                            <div class="col-md-3">
                                <i class="fas fa-gift dourado_mini"></i>
                                <p class="texto_mini mb-0">Embalagem exclusiva</p>
                            </div>
                            <div class="col-md-3">
                                <i class="fas fa-truck dourado_mini"></i>
                                <p class="texto_mini mb-0">Entrega segura</p>
                            </div>
                            <div class="col-md-3">
                                <i class="fas fa-lock dourado_mini"></i>
                                <p class="texto_mini mb-0">Pagamento seguro</p>
                            </div>
                            <div class="col-md-3">
                                <i class="fas fa-shield-alt dourado_mini"></i>
                                <p class="texto_mini mb-0">Satisfação garantida</p>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="rodape_final_justinho py-3">
                    <div class="container">
                        <div class="row align-items-center">
                            <div class="col-md-4">
                                <h6 class="text-white mb-0" style="font-size: 14px; letter-spacing: 1px;">BELLA AURA</h6>
                                <p class="text-muted mb-0" style="font-size: 11px;">Kits premium para momentos únicos.</p>
                            </div>

                            <div class="col-md-4 text-center">
                                <span class="text-muted" style="font-size: 12px;">suporte@bellaaura.com.br</span>
                            </div>

                            <div class="col-md-4 text-end">
                                <div class="redes_sociais_mini">
                                    <a href="https://www.instagram.com/seu_perfil" target="_blank" class="text-white ms-3"><i class="fab fa-instagram"></i></a>
                                    <a href="https://www.facebook.com/seu_perfil" target="_blank" class="text-white ms-3"><i class="fab fa-facebook-f"></i></a>
                                    <a href="https://www.tiktok.com/@@seu_perfil" target="_blank" class="text-white ms-3"><i class="fab fa-tiktok"></i></a>
                                    <a href="https://wa.me/5514997254987?text=Ol%C3%A1,%20gostaria%20de%20saber%20mais%20sobre%20os%20kits!" target="_blank" class="text-white ms-3"><i class="fab fa-whatsapp"></i></a>
                                </div>
                            </div>
                        </div>

                        <div class="text-center mt-3">
                            <p class="text-muted mb-0" style="font-size: 10px; opacity: 0.5;">
                                © 2026 Bella Aura. Todos os direitos reservados.
                            </p>
                        </div>
                    </div>
                </div>
            </footer>

            <style>
                            /* Estilo da Faixa de Benefícios com o fundo cinza e a sombra */
                            .faixa_beneficios_premium {
                                background-color: #111; /* Cinza bem escuro e elegante */
                                border-top: 1px solid #222;
                                box-shadow: 0px 4px 15px rgba(0, 0, 0, 0.5); /* Sombra para dar profundidade */
                                position: relative;
                                z-index: 2;
                            }

                            .rodape_final_justinho {
                                background-color: #000; /* Fundo totalmente preto para finalizar */
                            }

                            .dourado_mini {
                                color: #D4AF37;
                                font-size: 1.1rem;
                                margin-bottom: 5px;
                                display: block;
                            }

                            .texto_mini {
                                color: #eee;
                                font-size: 11px;
                                text-transform: uppercase;
                                letter-spacing: 0.5px;
                            }

                            .redes_sociais_mini i {
                                font-size: 14px;
                                transition: 0.3s;
                            }

                                .redes_sociais_mini i:hover {
                                    color: #D4AF37;
                                }

                            /* Remove qualquer margem que o navegador coloque no final da página */
                            body {
                                margin-bottom: 0 !important;
                                padding-bottom: 0 !important;
                            }
            </style>
        </div>
    </div>
</section>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const iconeVerSenha = document.querySelector(".icone_ver_senha");
        const inputSenha = document.querySelector("input[name='senha']");

        if (iconeVerSenha && inputSenha) {
            iconeVerSenha.addEventListener("click", function () {
                // Alterna o tipo do input entre password e text
                if (inputSenha.type === "password") {
                    inputSenha.type = "text";
                    // Muda o ícone para o olho aberto (se estiver usando FontAwesome)
                    iconeVerSenha.classList.remove("fa-eye");
                    iconeVerSenha.classList.add("fa-eye-slash");
                } else {
                    inputSenha.type = "password";
                    // Volta para o ícone do olho fechado
                    iconeVerSenha.classList.remove("fa-eye-slash");
                    iconeVerSenha.classList.add("fa-eye");
                }
            });
        }
    });
</script>