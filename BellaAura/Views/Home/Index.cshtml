@{
    ViewData["BodyClass"] = "pagina-home";
}

<section class="banner_principal">
    <div class="row align-items-center h-100">
        <div class="col-md-6 bloco_texto_banner">
            <h1 class="titulo_banner">ELEGÂNCIA<br><span class="detalhe_titulo">EM CADA DETALHE</span></h1>

            <p class="subtitulo_banner">Kits exclusivos que combinam com seu estilo.</p>

            <div class="grupo_botoes_banner">
                <a asp-controller="Home" asp-action="Kits" class="btn btn_dourado_cheio">VER KITS</a>
                <a asp-controller="Home" asp-action="MontarKit" class="btn btn_dourado_borda">MONTAR MEU KIT</a>

            </div>
        </div>

        <div class="col-md-6">
            <div class="quadro_placeholder_banner">
                <div class="conteudo_placeholder">
                    <i class="fas fa-box-open icone_placeholder"></i>
                    <p>[ Espaço para a foto dos Kits Premium de Perfumes ]</p>
                    <span>Resolução sugerida: 800x600px</span>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- SEÇÃO DE FILTROS RÁPIDOS -->
<section class="secao_filtros my-4">
    <div class="text-start" style="position: relative; top: -24px; z-index: 10;">
        <span style="color: #cda45e; font-size: 12px; letter-spacing: 2px; font-weight: 600; text-transform: uppercase; opacity: 0.9; padding-left: 5px;">
            Filtros Rápidos
        </span>
    </div>

    <div class="quadro_barra_filtros">
        <div class="row text-center g-4">

            <!-- ESTILO -->
            <div class="col-md-4 coluna_filtro">
                <span class="titulo_filtro"><i class="fas fa-pump-soap me-2"></i>ESTILO</span>
                <div class="grupo_botoes_filtro">
                    <button type="button" class="btn btn_filtro_opcao" data-tipo="estilo" data-valor="delicado">Delicado</button>
                    <button type="button" class="btn btn_filtro_opcao" data-tipo="estilo" data-valor="sensual">Sensual</button>
                    <button type="button" class="btn btn_filtro_opcao" data-tipo="estilo" data-valor="fresco">Fresco</button>
                    <button type="button" class="btn btn_filtro_opcao" data-tipo="estilo" data-valor="marcante">Marcante</button>
                </div>
            </div>

            <!-- FAMÍLIA OLFATIVA -->
            <div class="col-md-5 coluna_filtro barra_lateral_separadora">
                <span class="titulo_filtro"><i class="fas fa-seedling me-2"></i>FAMÍLIA OLFATIVA</span>
                <div class="grupo_botoes_filtro">
                    <button type="button" class="btn btn_filtro_opcao" data-tipo="familia" data-valor="doce">Doce</button>
                    <button type="button" class="btn btn_filtro_opcao" data-tipo="familia" data-valor="floral">Floral</button>
                    <button type="button" class="btn btn_filtro_opcao" data-tipo="familia" data-valor="amadeirado">Amadeirado</button>
                    <button type="button" class="btn btn_filtro_opcao" data-tipo="familia" data-valor="citrico">Cítrico</button>
                    <button type="button" class="btn btn_filtro_opcao" data-tipo="familia" data-valor="oriental">Oriental</button>
                </div>
            </div>

            <!-- PREÇO -->
            <div class="col-md-3 coluna_filtro barra_lateral_separadora">
                <span class="titulo_filtro"><i class="fas fa-tag me-2"></i>PREÇO</span>
                <div class="grupo_botoes_filtro">
                    <button type="button" class="btn btn_filtro_opcao" data-tipo="preco" data-valor="ate180">Até R$180</button>
                    <button type="button" class="btn btn_filtro_opcao" data-tipo="preco" data-valor="180a250">R$180 - R$250</button>
                    <button type="button" class="btn btn_filtro_opcao" data-tipo="preco" data-valor="acima250">R$250+</button>
                </div>
            </div>

        </div>
    </div>
</section>

