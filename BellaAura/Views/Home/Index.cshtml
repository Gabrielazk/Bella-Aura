<!-- 🧠 SCRIPT INTELIGENTE DE SELEÇÃO MÚLTIPLA DE FILTROS -->
<!-- 🧠 SCRIPT INTELIGENTE DE SELEÇÃO MÚLTIPLA DE FILTROS E FAVORITOS -->
<script>
    // Armazena os filtros ativos por categoria
    let filtrosAtivos = {
        estilo: null,
        familia: null,
        preco: null
    };

    document.addEventListener("DOMContentLoaded", function() {
        // 1. Carrega e pinta os corações salvos assim que a página abre
        atualizarIconesFavoritos();

        // 2. Configura os eventos de clique dos filtros
        const botoesHome = document.querySelectorAll('.secao_filtros .btn_filtro_opcao');

        botoesHome.forEach(btn => {
            btn.addEventListener('click', function() {
                const tipo = this.getAttribute('data-tipo');
                const valor = this.getAttribute('data-valor');

                if (filtrosAtivos[tipo] === valor) {
                    filtrosAtivos[tipo] = null;
                    this.classList.remove('active-gold-filter');
                } else {
                    const grupo = this.closest('.coluna_filtro');
                    if (grupo) {
                        grupo.querySelectorAll('.btn_filtro_opcao').forEach(b => b.classList.remove('active-gold-filter'));
                    }
                    filtrosAtivos[tipo] = valor;
                    this.classList.add('active-gold-filter');
                }

                aplicarFiltrosCruzadosHome();
            });
        });
    });

    // Função que aplica os filtros cruzados
    function aplicarFiltrosCruzadosHome() {
        const cards = document.querySelectorAll('.vitrine_produtos .item-vitrine-col');
        let encontrados = 0;

        cards.forEach(col => {
            const card = col.querySelector('.card_produto');
            if (!card) return;

            const estilo = card.getAttribute('data-estilo');
            const familia = card.getAttribute('data-familia');
            const preco = parseFloat(card.getAttribute('data-preco') || '0');

            let atendeEstilo = !filtrosAtivos.estilo || estilo === filtrosAtivos.estilo;
            let atendeFamilia = !filtrosAtivos.familia || familia === filtrosAtivos.familia;
            let atendePreco = true;

            if (filtrosAtivos.preco === 'ate180') atendePreco = preco <= 180;
            else if (filtrosAtivos.preco === '180a250') atendePreco = preco > 180 && preco <= 250;
            else if (filtrosAtivos.preco === 'acima250') atendePreco = preco > 250;

            if (atendeEstilo && atendeFamilia && atendePreco) {
                col.style.display = 'block';
                encontrados++;
            } else {
                col.style.display = 'none';
            }
        });

        // Manipula a mensagem de aviso
        let caixaAviso = document.getElementById('aviso-sem-produtos');
        const containerVitrine = document.querySelector('.vitrine_produtos');

        if (encontrados === 0) {
            if (!caixaAviso) {
                caixaAviso = document.createElement('div');
                caixaAviso.id = 'aviso-sem-produtos';
                caixaAviso.className = 'col-12 text-center py-5';
                caixaAviso.innerHTML = `
                    <div style="color: #cda45e; font-size: 18px; font-weight: 500;">
                        <i class="fas fa-search me-2"></i>Nenhum kit encontrado para essa combinação.
                    </div>
                    <p class="text-muted mt-2 small">Tente desmarcar alguns filtros para ver mais opções.</p>
                `;
                containerVitrine.appendChild(caixaAviso);
            }
            caixaAviso.style.display = 'block';
        } else if (caixaAviso) {
            caixaAviso.style.display = 'none';
        }
    }

    // Alterna a adição/remoção dos favoritos no LocalStorage
    function alternarFavorito(elemento, id, nome, preco, imagem, categoria) {
        let favoritos = JSON.parse(localStorage.getItem('bella_favoritos')) || [];
        const index = favoritos.findIndex(p => p.id === id);

        if (index === -1) {
            favoritos.push({ id, nome, preco, imagem, categoria });
        } else {
            favoritos.splice(index, 1);
        }

        localStorage.setItem('bella_favoritos', JSON.stringify(favoritos));

        // Atualiza a cor dos ícones imediatamente
        atualizarIconesFavoritos();
    }

    // Pinta de dourado todos os corações ativos (cards e topo)
    function atualizarIconesFavoritos() {
        let favoritos = JSON.parse(localStorage.getItem('bella_favoritos')) || [];
        const botoesFavorito = document.querySelectorAll('.btn-favorito-card-inline');

        // 1. Atualiza os corações dos Cards na Vitrine
        botoesFavorito.forEach(btn => {
            let idProduto = btn.getAttribute('data-id');

            if (!idProduto) {
                const onclickAttr = btn.getAttribute('onclick') || '';
                const match = onclickAttr.match(/alternarFavorito\(this,\s*'([^']+)'/);
                if (match && match[1]) idProduto = match[1];
            }

            const svg = btn.querySelector('svg');

            if (idProduto && svg) {
                const jaEhFavorito = favoritos.some(p => p.id === idProduto);

                if (jaEhFavorito) {
                    svg.setAttribute('fill', '#cda45e');
                    svg.setAttribute('stroke', '#cda45e');
                } else {
                    svg.setAttribute('fill', 'none');
                    svg.setAttribute('stroke', '#ffffff');
                }
            }
        });

        // 2. Atualiza o ícone de Coração do Menu Superior (Topo)
        const iconeTopo = document.querySelector('.nav-icon-favoritos svg, a[href*="Favoritos"] svg');
        if (iconeTopo) {
            if (favoritos.length > 0) {
                iconeTopo.setAttribute('fill', '#cda45e');
                iconeTopo.setAttribute('stroke', '#cda45e');
            } else {
                iconeTopo.setAttribute('fill', 'none');
                iconeTopo.setAttribute('stroke', '#ffffff');
            }
        }
    }
</script>