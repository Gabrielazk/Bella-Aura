<!-- 🎨 ESTILOS CSS -->
<style>
    .luxury-bg {
        background-color: #000000;
    }

    .abstract-wave {
        position: absolute;
        width: 100%;
        height: auto;
        pointer-events: none;
        z-index: 1;
    }

    .wave-1 {
        top: -50px;
        left: -10%;
        width: 120%;
        opacity: 0.85;
    }

    .wave-2 {
        bottom: 50px;
        right: -10%;
        width: 110%;
        opacity: 0.95;
    }

    .gold-glow {
        position: absolute;
        top: 40%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: 700px;
        height: 700px;
        background: radial-gradient(circle, rgba(205, 164, 94, 0.04) 0%, transparent 75%);
        z-index: 1;
        pointer-events: none;
        filter: blur(60px);
    }

    .quadro_barra_filtros .btn_filtro_opcao {
        border-radius: 4px;
        font-size: 12px;
        transition: all 0.3s ease;
        background: transparent;
        border: 1px solid #222;
        color: #888;
        text-align: center;
    }

    .btn_filtro_opcao.active-gold-filter {
        background-color: rgba(205, 164, 94, 0.2) !important;
        border-color: #cda45e !important;
        color: #cda45e !important;
        font-weight: 700 !important;
        transform: none !important; /* Mantém o botão alinhado na horizontal */
    }

    .btn-ajuda-presente {
        background: rgba(205, 164, 94, 0.08);
        border: 1px dashed #cda45e;
        color: #cda45e;
        font-size: 13px;
        font-weight: 600;
        border-radius: 4px;
        transition: all 0.3s ease;
    }

        .btn-ajuda-presente:hover {
            background: #cda45e;
            color: #000;
        }
</style>

<!-- 🧠 SCRIPT INTELIGENTE DE FILTROS -->
<script>
    let filtrosKits = {
        estilo: null,
        familia: null,
        preco: null,
        marca: null,
        ocasiao: null
    };

    document.addEventListener("DOMContentLoaded", function() {
        const botoesFiltro = document.querySelectorAll('.quadro_barra_filtros .btn_filtro_opcao');

        botoesFiltro.forEach(btn => {
            btn.addEventListener('click', function() {
                const tipo = this.getAttribute('data-tipo');
                const valor = this.getAttribute('data-valor');

                if (filtrosKits[tipo] === valor) {
                    filtrosKits[tipo] = null;
                    this.classList.remove('active-gold-filter');
                } else {
                    const grupo = this.closest('.coluna_filtro');
                    if (grupo) {
                        grupo.querySelectorAll('.btn_filtro_opcao').forEach(b => b.classList.remove('active-gold-filter'));
                    }
                    filtrosKits[tipo] = valor;
                    this.classList.add('active-gold-filter');
                }

                if (tipo === 'ocasiao' && (valor === 'aniversario' || valor === 'namorados' || valor === 'agradecimento')) {
                    mostrarBoxPresente();
                }

                aplicarFiltrosCruzadosKits();
            });
        });
    });

    function aplicarFiltrosCruzadosKits() {
        const cards = document.querySelectorAll('.col-lg-9 .card_produto');

        cards.forEach(card => {
            const col = card.closest('.item-vitrine-col');
            if (!col) return;

            const estilo = card.getAttribute('data-estilo');
            const familia = card.getAttribute('data-familia');
            const preco = parseFloat(card.getAttribute('data-preco') || '0');
            const marca = card.getAttribute('data-marca');
            const ocasiao = card.getAttribute('data-ocasiao') || '';

            let passaEstilo = !filtrosKits.estilo || (estilo === filtrosKits.estilo);
            let passaFamilia = !filtrosKits.familia || (familia === filtrosKits.familia);
            let passaMarca = !filtrosKits.marca || (marca === filtrosKits.marca);
            let passaOcasiao = !filtrosKits.ocasiao || ocasiao.includes(filtrosKits.ocasiao);

            let passaPreco = true;
            if (filtrosKits.preco) {
                if (filtrosKits.preco === 'ate180') passaPreco = preco <= 180;
                else if (filtrosKits.preco === '180a250') passaPreco = preco > 180 && preco <= 250;
                else if (filtrosKits.preco === 'acima250') passaPreco = preco > 250;
            }

            if (passaEstilo && passaFamilia && passaMarca && passaOcasiao && passaPreco) {
                col.style.display = 'block';
            } else {
                col.style.display = 'none';
            }
        });
    }

    function mostrarBoxPresente() {
        const box = document.getElementById('boxAssistentePresente');
        if (box) {
            box.style.display = 'block';
            box.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }
    }

    function fecharBoxPresente() {
        const box = document.getElementById('boxAssistentePresente');
        if (box) box.style.display = 'none';
    }

    function enviarParaChatPresente() {
        const detalhes = document.getElementById('inputDetalhesPresente').value;
        if (!detalhes.trim()) {
            alert('Por favor, digite quem você gostaria de presentear para podermos te ajudar!');
            return;
        }
        alert('Redirecionando para o assistente com a mensagem: ' + detalhes);
    }
</script>