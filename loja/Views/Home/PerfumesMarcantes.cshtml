@{
    ViewData["Title"] = "Perfumes Marcantes - Bella Aura";
}

<div class="luxury-bg" style="min-height: 100vh; background-color: #000; color: #fff;">
    <section class="container pt-4">

        <!-- ⬅️ BOTÃO VOLTAR PREMIUM -->
        <div class="my-4">
            <a asp-controller="Home" asp-action="Index" asp-fragment="rodape" class="btn_voltar_premium">
                <i class="fas fa-arrow-left me-2"></i> VOLTAR PARA A HOME
            </a>
        </div>

        <!-- CABEÇALHO COM TOQUE PREMIUM -->
        <div class="text-center mb-5 pb-4" style="border-bottom: 1px solid rgba(205, 164, 94, 0.15);">
            <span style="color: #cda45e; font-size: 11px; letter-spacing: 3px; font-weight: 600; text-transform: uppercase;">
                COLEÇÃO EXCLUSIVA
            </span>
            <h1 class="mt-2 mb-3" style="color: #ffffff; font-size: 28px; letter-spacing: 2px; font-weight: 400;">
                PERFUMES MARCANTES
            </h1>
            <p class="mx-auto" style="color: #888888; font-size: 14px; max-width: 550px; line-height: 1.6;">
                Fragrâncias com presença inesquecível, notas quentes e alta fixação. Selecionadas para quem faz questão de deixar sua marca.
            </p>
        </div>

        <!-- VITRINE DE PRODUTOS -->
        <div class="row g-4 mb-5">

            <!-- PRODUTO 1 -->
            <div class="col-md-3 mb-4">
                <div class="card_produto card-produto-premium" style="background-color: #111111; border-radius: 8px; overflow: hidden; display: flex; flex-direction: column;">
                    <div class="quadro_foto_produto" style="position: relative; width: 100%; height: 250px; overflow: hidden;">

                        <!-- ❤️ CORAÇÃO DE FAVORITO -->
                        <button type="button" class="btn-favorito-card-inline" data-id="kit-1" onclick="alternarFavorito(this, 'kit-1', 'Essência Gold Bella', 'R$ 280,00', 'https://images.unsplash.com/photo-1594035910387-fea47794261f?auto=format&fit=crop&w=500&q=80', 'marcantes')" style="position: absolute; top: 15px; right: 15px; z-index: 5; background: transparent; border: none; cursor: pointer;">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l8.72-8.72 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                            </svg>
                        </button>

                        <span class="tag_produto" style="background-color: #cda45e; color: #000; position: absolute; left: 15px; bottom: 15px; z-index: 5; padding: 4px 10px; font-size: 10px; font-weight: bold;">ALTA FIXAÇÃO</span>
                        <img src="https://images.unsplash.com/photo-1594035910387-fea47794261f?auto=format&fit=crop&w=500&q=80" style="width: 100%; height: 100%; object-fit: cover;">
                    </div>
                    <div class="p-3" style="background-color: #111111; flex-grow: 1;">
                        <h3 class="nome_produto m-0" style="font-size: 16px; font-weight: 500; color: #ffffff;">Essência Gold Bella</h3>
                        <p class="descricao_produto mt-1 mb-0" style="font-size: 13px; color: #888888;">Âmbar - Baunilha - Marcante</p>
                        <div class="d-flex justify-content-between align-items-center mt-3">
                            <span class="preco_produto" style="color: #ffffff; font-weight: bold;">R$ 280,00</span>
                            <a href="/Home/Detalhes?nome=Essência Gold Bella&preco=R$ 280,00&cheiro=Âmbar - Baunilha - Marcante&imagem=https://images.unsplash.com/photo-1594035910387-fea47794261f?auto=format&fit=crop&w=800&q=80" class="btn btn_ver_detalhes" style="border: 1px solid #cda45e; color: #cda45e; padding: 5px 15px; border-radius: 4px; font-size: 12px; text-decoration: none;">VER DETALHES</a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- PRODUTO 2 -->
            <div class="col-md-3 mb-4">
                <div class="card_produto card-produto-premium" style="background-color: #111111; border-radius: 8px; overflow: hidden; display: flex; flex-direction: column;">
                    <div class="quadro_foto_produto" style="position: relative; width: 100%; height: 250px; overflow: hidden;">

                        <!-- ❤️ CORAÇÃO DE FAVORITO -->
                        <button type="button" class="btn-favorito-card-inline" data-id="kit-8" onclick="alternarFavorito(this, 'kit-8', 'Kit Patchouli Imperial', 'R$ 295,00', 'https://images.unsplash.com/photo-1616949755610-8c9bbc08f138?auto=format&fit=crop&w=500&q=80', 'marcantes')" style="position: absolute; top: 15px; right: 15px; z-index: 5; background: transparent; border: none; cursor: pointer;">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l8.72-8.72 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                            </svg>
                        </button>

                        <span class="tag_produto" style="background-color: #4a2c2a; color: #fff; position: absolute; left: 15px; bottom: 15px; z-index: 5; padding: 4px 10px; font-size: 10px; font-weight: bold;">INTENSO</span>
                        <img src="https://images.unsplash.com/photo-1616949755610-8c9bbc08f138?auto=format&fit=crop&w=500&q=80" style="width: 100%; height: 100%; object-fit: cover;">
                    </div>
                    <div class="p-3" style="background-color: #111111; flex-grow: 1;">
                        <h3 class="nome_produto m-0" style="font-size: 16px; font-weight: 500; color: #ffffff;">Kit Patchouli Imperial</h3>
                        <p class="descricao_produto mt-1 mb-0" style="font-size: 13px; color: #888888;">Patchouli - Almíscar - Sedutor</p>
                        <div class="d-flex justify-content-between align-items-center mt-3">
                            <span class="preco_produto" style="color: #ffffff; font-weight: bold;">R$ 295,00</span>
                            <a href="/Home/Detalhes?nome=Kit Patchouli Imperial&preco=R$ 295,00&cheiro=Patchouli - Almíscar - Sedutor&imagem=https://images.unsplash.com/photo-1616949755610-8c9bbc08f138?auto=format&fit=crop&w=800&q=80" class="btn btn_ver_detalhes" style="border: 1px solid #cda45e; color: #cda45e; padding: 5px 15px; border-radius: 4px; font-size: 12px; text-decoration: none;">VER DETALHES</a>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </section>
</div>

@await Html.PartialAsync("_RodapeHome")

<style>
    /* Estilo do botão voltar premium */
    .btn_voltar_premium {
        display: inline-flex;
        align-items: center;
        color: #cda45e !important;
        background-color: transparent;
        border: 1px solid #cda45e;
        padding: 6px 16px;
        border-radius: 4px;
        font-size: 11px;
        font-weight: 600;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        text-decoration: none !important;
        transition: all 0.3s ease;
    }

        .btn_voltar_premium:hover {
            background-color: #cda45e !important;
            color: #000000 !important;
            box-shadow: 0 0 10px rgba(205, 164, 94, 0.4);
            transform: translateX(-3px);
        }

            .btn_voltar_premium:hover i {
                color: #000000 !important;
            }

    /* Estilo dos favoritos nos cards */
    .btn-favorito-card-inline {
        background: none !important;
        border: none !important;
        padding: 0 !important;
        margin: 0 !important;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        transition: transform 0.2s ease;
    }

        .btn-favorito-card-inline:hover {
            transform: scale(1.15);
        }
</style>
