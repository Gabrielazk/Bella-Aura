<!-- 🧠 JAVASCRIPT CORRIGIDO -->
<script>
    function trocarFoto(src) {
        document.getElementById('fotoPrincipal').src = src;
        document.querySelectorAll('.miniatura-foto').forEach(img => img.classList.remove('active'));
        if (event && event.target) event.target.classList.add('active');
    }

    function adicionarAoCarrinhoPremium(id, nome, preco, foto) {
        let carrinho = JSON.parse(localStorage.getItem('carrinhoBellaAura')) || [];
        let itemExistente = carrinho.find(item => item.id === id);

        if (itemExistente) {
            itemExistente.qtd += 1;
        } else {
            carrinho.push({
                id: id,
                nome: nome,
                preco: parseFloat(preco),
                qtd: 1,
                foto: foto
            });
        }

        localStorage.setItem('carrinhoBellaAura', JSON.stringify(carrinho));

        // Atualiza a bolinha do menu na hora
        if (typeof atualizarBadgeGlobal === 'function') {
            atualizarBadgeGlobal();
        } else {
            let badge = document.getElementById('badgeCarrinho');
            if (badge) {
                let total = 0;
                carrinho.forEach(i => total += i.qtd);
                badge.innerText = total;
            }
        }

        alert(`✨ "${nome}" foi adicionado ao seu carrinho!`);
    }

    document.addEventListener("DOMContentLoaded", function() {
        const estrelas = document.querySelectorAll('.estrela-click-gold');
        const inputNota = document.getElementById('notaSelecionadaGold');

        estrelas.forEach(estrela => {
            estrela.addEventListener('click', function() {
                const valor = parseInt(this.getAttribute('data-valor'));
                inputNota.value = valor;

                estrelas.forEach(e => {
                    const eValor = parseInt(e.getAttribute('data-valor'));
                    if (eValor <= valor) {
                        e.classList.remove('far');
                        e.classList.add('fas');
                        e.style.color = '#ffd700';
                    } else {
                        e.classList.remove('fas');
                        e.classList.add('far');
                        e.style.color = '#444444';
                    }
                });
            });
        });
    });

    function enviarOpiniaoPremium(event) {
        event.preventDefault();

        const nota = parseInt(document.getElementById('notaSelecionadaGold').value);
        const nome = document.getElementById('nomeClienteGold').value;
        const texto = document.getElementById('textoOpiniaoGold').value;

        if (nota === 0) {
            alert("Por favor Gabi, selecione as estrelinhas para dar sua nota! 😉");
            return;
        }

        let estrelasHtml = "";
        for (let i = 0; i < 5; i++) {
            if (i < nota) {
                estrelasHtml += '<i class="fas fa-star" style="color: #ffd700;"></i>';
            } else {
                estrelasHtml += '<i class="far fa-star" style="color: #444444;"></i>';
            }
        }

        const lista = document.getElementById('listaComentariosGold');
        const novoComentario = document.createElement('div');
        novoComentario.className = "pb-2 border-bottom border-secondary border-opacity-10";
        novoComentario.innerHTML = `
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="fw-bold text-white" style="font-size: 13px;">${nome}</span>
                    <span class="badge bg-success-subtle text-success ms-2" style="font-size: 9px;">Compra VIP Verificada ✔</span>
                </div>
                <small class="text-muted" style="font-size: 10px;">Agora mesmo</small>
            </div>
            <div class="my-1" style="font-size: 10px;">${estrelasHtml}</div>
            <p style="font-size: 12px; color: #ccc;" class="m-0">${texto}</p>
        `;

        lista.insertBefore(novoComentario, lista.firstChild);

        document.getElementById('formAvaliacaoPremium').reset();
        document.getElementById('notaSelecionadaGold').value = "0";
        document.querySelectorAll('.estrela-click-gold').forEach(e => {
            e.classList.remove('fas');
            e.classList.add('far');
            e.style.color = '#444444';
        });

        alert("Avaliação VIP publicada com sucesso! 👑✨");
    }
</script>