@{
    ViewData["Title"] = "Mais Desejados - Bella Aura";
}

<div class="luxury-bg" style="padding-top: 30px; min-height: 100vh; background-color: #000; color: #fff;">
    <section class="container my-5">
        <div class="d-flex justify-content-between align-items-center mb-5 pb-3" style="border-bottom: 1px solid rgba(205, 164, 94, 0.15);">
            <h2 class="titulo_secao" style="color: #cda45e; font-size: 24px; letter-spacing: 2px; margin: 0;">MAIS DESEJADOS</h2>
            <span class="text-muted small" style="letter-spacing: 2px; color: rgba(205, 164, 94, 0.6) !important;">OS FAVORITOS DA LOJA</span>
        </div>

        <p class="text-center mb-5" style="color: #aaa; font-size: 15px; max-width: 600px; margin: 0 auto;">
            Os campeões de venda e os mais adicionados à lista de desejos pelos nossos clientes.
        </p>

        <div class="row g-4">
            <!-- Card 1 -->
            <div class="col-md-3 mb-4">
                <div class="card_produto card-produto-premium" style="background-color: #111111; border-radius: 8px; overflow: hidden; display: flex; flex-direction: column;">
                    <div class="quadro_foto_produto" style="position: relative; width: 100%; height: 250px; overflow: hidden;">
                        <span class="tag_produto" style="background-color: #d2b48c; color: #000; position: absolute; left: 15px; bottom: 15px; z-index: 5; padding: 4px 10px; font-size: 10px; font-weight: bold;">BEST SELLER</span>
                        <img src="https://images.unsplash.com/photo-1595425970377-c9703cf48b6d?auto=format&fit=crop&w=500&q=80" style="width: 100%; height: 100%; object-fit: cover;">
                    </div>
                    <div class="p-3" style="background-color: #111111; flex-grow: 1;">
                        <h3 class="nome_produto m-0" style="font-size: 16px; font-weight: 500; color: #ffffff;">Kit Baunilha & Poesia</h3>
                        <p class="descricao_produto mt-1 mb-0" style="font-size: 13px; color: #888888;">Fava Tonka - Orquídea - Adocicado</p>
                        <div class="d-flex justify-content-between align-items-center mt-3">
                            <span class="preco_produto" style="color: #ffffff; font-weight: bold;">R$ 225,00</span>
